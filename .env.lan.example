# =============================================================================
# LAN / VM testing environment (Ubuntu VM, Traefik HTTPS edge)
#
# Goal:
# - Access everything via ONE LAN hostname + PATHS:
#     https://erpq.lan/
#     https://erpq.lan/login
#     https://erpq.lan/hr
#     https://erpq.lan/crm
#     https://erpq.lan/api/...
#     https://erpq.lan/auth/...
#
# Usage (recommended — pre-built GHCR images, no build on VM):
#   cp .env.lan.example .env.lan
#   Edit GHCR_OWNER, GHCR_PREFIX, APP_VERSION (same tag you pushed from CI).
#   If images are private:  echo YOUR_GHCR_PAT | docker login ghcr.io -u YOUR_GH_USER --password-stdin
#   chmod +x scripts/lan-ghcr.sh
#   ./scripts/lan-ghcr.sh pull
#   ./scripts/lan-ghcr.sh up -d
#
# Same thing without the helper script:
#   docker compose -f docker-compose.production.yml -f docker-compose.traefik.yml --env-file .env.lan pull
#   docker compose -f docker-compose.production.yml -f docker-compose.traefik.yml --env-file .env.lan up -d
#
# Build images on the VM instead (full repo required):
#   docker compose -f docker-compose.lan.build-from-source.yml --env-file .env.lan up -d --build
#
# TLS (local, recommended):
# - Generate certs with mkcert and place them here:
#     traefik/dynamic/certs/dev.crt
#     traefik/dynamic/certs/dev.key
# - The default cert is configured in: traefik/dynamic/tls-local.yml
#
# Client DNS:
# - Easiest: add hosts entry on each client pointing to the VM IP:
#     <VM_LAN_IP>  erpq.lan
# =============================================================================

# --- 1. Public LAN hostname (what browsers use) -------------------------------
PUBLIC_HOST=erpq.lan
PUBLIC_SCHEME=https

# --- 2. Browser URLs (single-host, path-based routing behind Traefik) ---------
NEXT_PUBLIC_COMDASH_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}
NEXT_PUBLIC_AUTH_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}/login
NEXT_PUBLIC_APIGATE_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}
NEXT_PUBLIC_AUTHQ_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}/auth

# --- 3. AuthQ (auth service) — public URL and OAuth redirects -----------------
AUTHQ_PUBLIC_BASE_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}/auth
AUTHQ_OAUTH_RETURN_URL_PREFIXES=${PUBLIC_SCHEME}://${PUBLIC_HOST}
AUTHQ_OAUTH_DEFAULT_RETURN_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}/
AUTHQ_OAUTH_DEFAULT_ALLOWED_DOC_TYPES=design,cad,general,manual,policy,spec,contract
# Comma-separated docQ workflow admins (get full admin access after re-login):
AUTHQ_DOCQ_ADMIN_EMAILS=you@yourcompany.eu

AUTHQ_GOOGLE_CLIENT_ID=
AUTHQ_GOOGLE_CLIENT_SECRET=
AUTHQ_GOOGLE_REDIRECT_URI=${AUTHQ_PUBLIC_BASE_URL}/oauth/google/callback

AUTHQ_ZOHO_CLIENT_ID=
AUTHQ_ZOHO_CLIENT_SECRET=
AUTHQ_ZOHO_REDIRECT_URI=${AUTHQ_PUBLIC_BASE_URL}/oauth/zoho/callback
# India DC personal/org accounts: accounts.zoho.in (not .com)
AUTHQ_ZOHO_ACCOUNTS_HOST=accounts.zoho.in
# In Zoho API console (Server-based app), register exactly:
#   https://erpq.lan/auth/oauth/zoho/callback
#   https://erpq.lan/auth/oauth/google/callback
#
# B2B: only customer org email domains may complete OAuth (comma-separated).
# Empty = open (dev). Example: ortusolis.in
AUTHQ_ALLOWED_EMAIL_DOMAINS=
# Optional exact emails in addition to domains:
# AUTHQ_ALLOWED_EMAILS=
# Multi-tenant registry (one entry per sold customer / Zoho org):
# CITYQ_TENANTS_JSON=[{"id":"ortusolis","name":"Ortusolis","allowedEmailDomains":["ortusolis.in"]}]
CITYQ_TENANTS_JSON=
# Org Zoho account that owns managed WorkDrive files (must sign in once to link tokens).
DOCQ_SERVICE_ZOHO_EMAIL=
# Shared WorkDrive parent (Team Folder id). Empty = first team workspace the user can see.
DOCQ_SHARED_PARENT_FOLDER_ID=
DOCQ_MANAGED_FOLDER_NAME=Managed Org Folder
DOCQ_DUMP_FOLDER_NAME=Shared Dump Folder

# --- 4. Shared secrets (LAN testing; still change from defaults) --------------
JWT_SECRET=change-me-lan-long-random
CITYQ_INTERNAL_KEY=change-me-lan-long-random
CITYQ_SERVICE_KEY=change-me-lan-service-key
# Platform Postgres (shared; docQ uses schema `docq`)
CITYQ_DB_PASSWORD=cityq_lan_change_me
# 32-byte base64 key (AES-256-GCM) for encrypting Zoho refresh tokens at rest.
DOCQ_TOKEN_ENC_KEY_B64=
# India DC: https://www.zohoapis.in (auto-derived from accounts host if omitted)
DOCQ_WORKDRIVE_API_BASE=https://www.zohoapis.in

# --- 5. RabbitMQ --------------------------------------------------------------
RABBITMQ_DEFAULT_USER=erpq
RABBITMQ_DEFAULT_PASS=erpq_lan_change_me
CITYQ_MQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672

# --- 6. ERPNext integration (optional) ---------------------------------------
# What apiGate calls server-side (set if you have an ERPNext instance):
ERPNEXT_URL=cityqerp.ortusolis.in
# What the browser uses for iframe URLs (if you expose erp-proxy via Traefik):
ERPNEXT_PUBLIC_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}/erp
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_CRM_PATH=/app/crm
ERPNEXT_IFRAME_QUERY=
ERP_ALLOW_DOCTYPE_DISCOVERY=0
ERP_PARTNER_RATE_MAX=600
PAYMENT_PARTNER_RATE_MAX=120
DOCQ_PARTNER_RATE_MAX=300
ERP_DEFAULT_DOCTYPES=Lead,Opportunity,Customer,Contact,DocType,Quotation

# --- 7. Module flags ----------------------------------------------------------
CITYQ_MODULE_ERP=1
CITYQ_MODULE_CRM=1
CITYQ_PORTAL_HRQ=1
CITYQ_PORTAL_PURQ=1
CITYQ_PORTAL_SUPPLIERQ=1

# --- 8. auth-web --------------------------------------------------------------
NEXT_PUBLIC_LOGIN_DEV_BYPASS=false
NEXT_PUBLIC_ERPNEXT_SITE_LABEL=ERPNext
AUTH_WEB_ASSET_PREFIX=/login

# --- 9. Traefik (LAN) ---------------------------------------------------------
# LAN uses local certs (mkcert) via traefik/dynamic/tls-local.yml.
# Do NOT set a cert resolver here.
TRAEFIK_CERTRESOLVER=
# Optional: expose Traefik dashboard on http://<vm-ip>:8088 (NOT recommended on shared LAN)
TRAEFIK_DASHBOARD_INSECURE=false
TRAEFIK_DASHBOARD_PORT=8088
TRAEFIK_LOG_LEVEL=INFO
# When using a remote Docker context from Windows, this must be an absolute path on the VM.
TRAEFIK_DYNAMIC_DIR=/home/sharath/erpq/traefik/dynamic

# --- 10. nginx-proxy profile vars (unused in Traefik mode) --------------------
NGINX_PROXY_HTTP_PORT=8081
VIRTUAL_HOST_MQ=
VIRTUAL_HOST_CORE=
VIRTUAL_HOST_AUTH=
VIRTUAL_HOST_API=
VIRTUAL_HOST_DASHBOARD=

# --- 11. GHCR images (required for docker-compose.production.yml / lan-ghcr.sh) --
GHCR_OWNER=sharath-ots
GHCR_PREFIX=erpq
APP_VERSION=latest

